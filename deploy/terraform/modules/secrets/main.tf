# The hub's admin token: generated by Terraform, stored as an SSM SecureString.
# It is also in Terraform state, which is why the state bucket is private, encrypted and TLS-only.

variable "name" { type = string }

resource "random_password" "admin_token" {
  length  = 40
  special = false
}

resource "aws_ssm_parameter" "admin_token" {
  #checkov:skip=CKV_AWS_337:SecureString with the AWS-managed SSM key; a customer-managed key is a production step
  name        = "/konjir/${var.name}/admin-token"
  description = "Konjir hub admin token (adds actors, opens sessions)"
  type        = "SecureString"
  value       = "kja_${random_password.admin_token.result}"
}

output "admin_token_param_name" { value = aws_ssm_parameter.admin_token.name }
output "admin_token_param_arn" { value = aws_ssm_parameter.admin_token.arn }
