// konjir.com's viewer-request function (cloudfront-js-2.0). www.konjir.com is the site's host, and
// konjir.com redirects to it (Lee, 2026-11-20): on the apex every request answers with a 301 to
// https://www.konjir.com, path and query kept, a page that moved straight to where it is now, in one
// hop. The redirect is built from the fixed www host, never from the Host header, and only a request
// whose host is exactly the apex takes it; every other host is answered as www.
// Known consequence: until 2026-11-19 the function answered www with a 301 to the apex, with no
// Cache-Control, so a browser may still hold it for a www URL it visited then (www.konjir.com/
// above all). For that browser, that URL loops (www -> apex -> www) until the entry leaves its cache;
// clearing konjir.com's and www.konjir.com's cached data fixes it. URLs that never existed on www
// before, the moved pages' new ones among them, aren't affected.
//
// On www the pages that moved when the site was split by product answer with a 301 to where they
// are now, path below them and query kept: /hands-on and /hands-on/… to /kolab/hands-on/…, and
// /messages and /messages/… to /konnect/guide/… A browser keeps a link's #fragment through a
// redirect, so old links to a heading still land on it. Every 301 here may be cached a day, no
// longer, so a later change of direction reaches browsers.
// A folder's page is its index.html (S3 behind OAC has no index documents, and
// default_root_object covers only "/"): a path ending in "/" is served from <path>index.html, and
// a path whose last segment has no "." (/kolab) answers with a 301 to the same path with "/" added.
// A path that holds "\" is none of these on either host, and on www neither is one that starts
// "//". Every other request passes.
// Two paths are served as they are, never redirected, as Apple and Google require: konnect's app
// links, /.well-known/apple-app-site-association and /.well-known/assetlinks.json (all of
// /.well-known/ passes as it came), and konnect's app's sign-in redirects, /konnect/app/oauth for
// the production build and /konnect/app/preview/oauth for the preview build, each served from its
// own index.html in place, so the code in its query is never sent anywhere again by a redirect;
// the page never reads it.
// Tested in apps/cli/test/site-www-redirect.test.ts.
function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : '';
  // The query as the browser sent it, never rebuilt from the parsed one, which could change its
  // meaning. rawQueryString() is a cloudfront-js-2.0 helper; were it ever missing, a redirect
  // drops the query rather than failing.
  var query = typeof request.rawQueryString === 'function' ? request.rawQueryString() : '';
  var redirect = function (location) {
    return {
      statusCode: 301,
      statusDescription: 'Moved Permanently',
      headers: {
        location: { value: location + (query ? '?' + query : '') },
        'cache-control': { value: 'public, max-age=86400' }
      }
    };
  };
  var uri = request.uri;
  // A path holding "\" is never rewritten or redirected (a browser may read "\" as "/", so "/\x"
  // could name another host): it passes as it came, to be a 404.
  if (uri.indexOf('\\') >= 0) return request;
  var moved = movedTo(uri);
  // From the apex, to the same path on www, or a moved page's new one, in one hop. Only a path
  // that starts with "/" is appended to the fixed host, so the location's host is always www, even
  // for "//evil.example"; any other (CloudFront sends none) passes, to be a 404.
  if (host === '${apex}') return uri.charAt(0) === '/' ? redirect('https://${www}' + (moved || uri)) : request;
  if (moved) return redirect(moved);
  if (uri.indexOf('/.well-known/') === 0) return request;
  if (uri === '/konnect/app/oauth' || uri === '/konnect/app/preview/oauth') {
    request.uri = uri + '/index.html';
    return request;
  }
  if (uri.charAt(uri.length - 1) === '/') {
    if (uri !== '/') request.uri = uri + 'index.html';
    return request;
  }
  var last = uri.slice(uri.lastIndexOf('/') + 1);
  // A path redirected relative to this host, so "//evil.example" can't become another host's URL.
  if (last.indexOf('.') < 0 && uri.charAt(0) === '/' && uri.charAt(1) !== '/') return redirect(uri + '/');
  return request;
}

// Where a page that moved is now, or null. Each old folder's own path gains its "/" here, so it
// takes one redirect, not two. The new path always starts with its folder, so it stays on this host.
function movedTo(uri) {
  var moves = [['/hands-on', '/kolab/hands-on'], ['/messages', '/konnect/guide']];
  for (var i = 0; i < moves.length; i++) {
    var from = moves[i][0];
    if (uri === from) return moves[i][1] + '/';
    if (uri.indexOf(from + '/') === 0) return moves[i][1] + uri.slice(from.length);
  }
  return null;
}
