{
  // tsx uses this file: bin/konjir and deploy/release/start.sh point TSX_TSCONFIG_PATH at it.
  // It brings in experimentalDecorators from the base, which NestJS needs. tsx applies it only
  // to files it includes, so it keeps the default (everything). Projects type-check with
  // their own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true }
}
