{
  "name": "konjir",
  "version": "0.5.0",
  "private": true,
  "description": "konjir: the Kolab verbs from a shell, as an MCP client of Kolab",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@konjir/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "bundle": "node scripts/package.mjs npm",
    "compile": "node scripts/package.mjs binaries"
  },
  "dependencies": {
    "@konjir/login": "*",
    "@konjir/server": "*",
    "@konjir/types": "*",
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "devDependencies": {
    "@konjir/engine": "*",
    "jsonc-parser": "^3.3.1"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^production",
          "jest",
          "{workspaceRoot}/deploy/release/start.sh",
          "{workspaceRoot}/deploy/release/install.sh"
        ]
      },
      "bundle": {
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/scripts/package.mjs",
          "{projectRoot}/bun-runtimes.json",
          {
            "externalDependencies": [
              "@modelcontextprotocol/client"
            ]
          },
          "{projectRoot}/README.npm.md"
        ],
        "outputs": [
          "{projectRoot}/dist-npm"
        ],
        "cache": true
      },
      "compile": {
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/scripts/package.mjs",
          "{projectRoot}/bun-runtimes.json",
          {
            "externalDependencies": [
              "@modelcontextprotocol/client"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist-bin"
        ],
        "cache": false
      }
    }
  }
}
