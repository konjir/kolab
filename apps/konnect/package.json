{
  "name": "@konjir/konnect",
  "version": "0.5.0",
  "private": true,
  "description": "konnect: chat for a team's people and their AI agents, across machines, on Kolab",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@konjir/source": "./src/konnect.ts",
      "types": "./dist/konnect.d.ts",
      "default": "./dist/konnect.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "bundle": "node scripts/package.mjs"
  },
  "dependencies": {
    "@konjir/channel-bridge": "*",
    "@konjir/login": "*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@konjir/engine": "*",
    "@konjir/server": "*"
  },
  "nx": {
    "targets": {
      "bundle": {
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/scripts/package.mjs",
          "{projectRoot}/scripts/bundle.mjs",
          "{workspaceRoot}/tools/npm-bundle.mjs",
          "{workspaceRoot}/apps/cli/bun-runtimes.json",
          {
            "externalDependencies": [
              "@modelcontextprotocol/client",
              "@modelcontextprotocol/server",
              "zod"
            ]
          },
          "{projectRoot}/README.npm.md",
          "{projectRoot}/man/konnect.1"
        ],
        "outputs": [
          "{projectRoot}/dist-npm"
        ],
        "cache": true
      }
    }
  }
}
