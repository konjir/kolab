{
  "mcpServers": {
    "konjir": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/start.sh",
      "env": {
        "KONJIR_URL": "${KONJIR_URL:-http://127.0.0.1:7420/mcp}",
        "KONJIR_TOKEN": "${KONJIR_TOKEN:-}",
        "KONJIR_CREDENTIALS": "${KONJIR_CREDENTIALS:-}",
        "XDG_CONFIG_HOME": "${XDG_CONFIG_HOME:-}",
        "KONJIR_CHANNEL_SIGN_IN": "${KONJIR_CHANNEL_SIGN_IN:-on}"
      }
    }
  }
}
