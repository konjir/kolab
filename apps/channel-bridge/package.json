{
  "name": "@konjir/channel-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "The Konjir channel for Claude Code: serves Kolab's tools on one sign-in, and forwards Kolab inbox changes into a session as channel messages",
  "type": "module",
  "exports": {
    ".": {
      "@konjir/source": "./src/channel.ts",
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest"
  },
  "dependencies": {
    "@konjir/login": "*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@onivoro/server-mcp": "^25.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@konjir/engine": "*",
    "@konjir/server": "*"
  }
}
