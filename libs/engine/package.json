{
  "name": "@konjir/engine",
  "version": "0.5.0",
  "private": true,
  "description": "The Kolab engine: versions, links, marks, the cascade, rebases and roles",
  "type": "module",
  "exports": {
    ".": {
      "@konjir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@konjir/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "measure": "tsx --conditions=@konjir/source scripts/measure.ts",
    "rebase-storm": "NODE_OPTIONS=--expose-gc tsx --conditions=@konjir/source scripts/rebase-storm.ts"
  },
  "dependencies": {
    "ulid": "^3.0.2",
    "@konjir/address": "*",
    "@konjir/db": "*",
    "@konjir/types": "*",
    "pg": "^8.23.1"
  }
}
