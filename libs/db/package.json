{
  "name": "@konjir/db",
  "version": "0.5.0",
  "private": true,
  "description": "The Kolab database: its schema, its migration and the connection through Kysely",
  "type": "module",
  "exports": {
    ".": {
      "@konjir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@konjir/types": "*",
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  }
}
