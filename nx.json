{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/scripts/**/*",
      "!{projectRoot}/jest.config.js"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.check.json",
      "{workspaceRoot}/tsconfig.build.json",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/deploy/terraform/modules/kolab/main.tf"
    ],
    "jest": [
      "{workspaceRoot}/jest.preset.js",
      "{workspaceRoot}/jest.setup.js",
      "{workspaceRoot}/jest.global-setup.js",
      "{workspaceRoot}/jest.global-teardown.js",
      {
        "env": "KONJIR_TEST_POSTGRES"
      },
      {
        "env": "KONJIR_TEST_DATABASE_URL"
      },
      {
        "externalDependencies": [
          "jest",
          "@jest/globals",
          "@swc/jest",
          "@swc/core"
        ]
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "jest"
      ],
      "cache": true
    }
  },
  "release": {
    "projects": [
      "konjir"
    ],
    "releaseTag": {
      "pattern": "konjir@{version}"
    },
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "conventionalCommits": false,
      "versionActions": "apps/cli/scripts/version-actions.cjs",
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      },
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    }
  }
}
