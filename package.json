{
  "name": "kolab",
  "version": "0.5.0",
  "private": true,
  "description": "Kolab, Konjir's server, with its CLI and shared libraries, as an Nx workspace",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck && tsc -p tsconfig.json",
    "build": "nx run-many -t build",
    "measure": "nx run @konjir/engine:measure --",
    "serve": "tsx apps/cli/src/main.ts serve",
    "konjir": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "nx": "23.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "konjir": "./bin/konjir"
  },
  "nx": {
    "includedScripts": []
  }
}
