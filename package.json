{
  "name": "kolab",
  "version": "0.5.0",
  "private": true,
  "description": "Kolab, Konjir's server, with its CLI and shared libraries, as an Nx workspace",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "measure": "nx run @konjir/engine:measure --output-style=stream --",
    "rebase-storm": "nx run @konjir/engine:rebase-storm --output-style=stream --",
    "serve": "bin/konjir serve",
    "konjir": "bin/konjir",
    "test:postgres": "KONJIR_TEST_POSTGRES=1 nx run-many -t test"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "nx": "23.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "konjir": "./bin/konjir"
  },
  "nx": {
    "includedScripts": []
  }
}
